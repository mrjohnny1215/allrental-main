{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/products_data.json",
      "dest": "/products_data.json"
    },
    {
      "src": "/merged_products.json",
      "dest": "/merged_products.json"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}